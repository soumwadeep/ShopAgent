# Server-only retailer credentials. Add these to .env.local; never use NEXT_PUBLIC_ here.
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_CREATORS_CREDENTIAL_VERSION=
AMAZON_PARTNER_TAG_IN=
AMAZON_PARTNER_TAG_US=
AMAZON_PARTNER_TAG_GB=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Server-only credentials for authorized partner feeds. Use ONE of these options.
# Local: absolute path to a Firebase service account JSON file (keep it outside git).
GOOGLE_APPLICATION_CREDENTIALS=
# Deployment alternative: JSON string stored as a server secret, not NEXT_PUBLIC_.
FIREBASE_SERVICE_ACCOUNT_JSON=
